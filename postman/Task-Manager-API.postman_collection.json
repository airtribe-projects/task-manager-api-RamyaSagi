{
  "info": {
    "_postman_id": "a1b2c3d4-task-manager-api",
    "name": "Task Manager API",
    "description": "Collection to exercise the Task Manager REST API. Start the server with `node app.js` (default port 3000), then run requests in order or adjust the `taskId` variable after creating a task.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "taskId", "value": "1" }
  ],
  "item": [
    {
      "name": "Tasks",
      "item": [
        {
          "name": "GET /tasks — list all",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/tasks"
          }
        },
        {
          "name": "GET /tasks — filter & sort",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/tasks?completed=false&order=desc"
          }
        },
        {
          "name": "GET /tasks — invalid completed (expect 400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/tasks?completed=maybe"
          }
        },
        {
          "name": "GET /tasks/priority/:level — high",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/tasks/priority/high"
          }
        },
        {
          "name": "GET /tasks/priority/:level — invalid (expect 400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/tasks/priority/urgent"
          }
        },
        {
          "name": "GET /tasks/:id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/tasks/{{taskId}}"
          }
        },
        {
          "name": "GET /tasks/:id — not found (expect 404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/tasks/999999"
          }
        },
        {
          "name": "POST /tasks — create (with priority)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman task\",\n  \"description\": \"Created from Postman collection\",\n  \"completed\": false,\n  \"priority\": \"low\"\n}"
            },
            "url": "{{baseUrl}}/tasks"
          }
        },
        {
          "name": "POST /tasks — create (default priority medium)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman task no priority\",\n  \"description\": \"Priority defaults to medium\",\n  \"completed\": false\n}"
            },
            "url": "{{baseUrl}}/tasks"
          }
        },
        {
          "name": "POST /tasks — invalid body (expect 400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Missing other fields\"\n}"
            },
            "url": "{{baseUrl}}/tasks"
          }
        },
        {
          "name": "PUT /tasks/:id — update",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated from Postman\",\n  \"description\": \"Updated description\",\n  \"completed\": true,\n  \"priority\": \"high\"\n}"
            },
            "url": "{{baseUrl}}/tasks/{{taskId}}"
          }
        },
        {
          "name": "PUT /tasks/:id — invalid completed type (expect 400)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Bad\",\n  \"description\": \"Bad\",\n  \"completed\": \"true\"\n}"
            },
            "url": "{{baseUrl}}/tasks/{{taskId}}"
          }
        },
        {
          "name": "DELETE /tasks/:id",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/tasks/{{taskId}}"
          }
        },
        {
          "name": "DELETE /tasks/:id — not found (expect 404)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/tasks/999999"
          }
        }
      ]
    }
  ]
}
